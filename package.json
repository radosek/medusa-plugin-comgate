{
	"name": "medusa-plugin-comgate",
	"version": "0.2.4",
	"description": "Comgate payment provider for Medusa v2",
	"keywords": [
		"comgate",
		"czech",
		"medusa",
		"medusa-plugin",
		"medusa-plugin-integration",
		"medusa-plugin-payment",
		"medusa-v2",
		"payment"
	],
	"homepage": "https://github.com/radosek/medusa-plugin-comgate#readme",
	"bugs": {
		"url": "https://github.com/radosek/medusa-plugin-comgate/issues"
	},
	"license": "MIT",
	"author": "Radoš Petrović",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/radosek/medusa-plugin-comgate.git"
	},
	"files": [
		".medusa/server",
		"LICENSE"
	],
	"exports": {
		"./package.json": "./package.json",
		"./providers/*": "./.medusa/server/providers/*/index.js",
		"./*": "./.medusa/server/*.js"
	},
	"scripts": {
		"build": "NODE_ENV=production medusa plugin:build",
		"watch": "medusa plugin:develop",
		"plugin:build": "NODE_ENV=production medusa plugin:build",
		"plugin:develop": "medusa plugin:develop",
		"plugin:publish": "medusa plugin:publish",
		"typecheck": "tsc -p tsconfig.test.json --noEmit",
		"lint": "oxlint",
		"format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
		"test": "jest --passWithNoTests src",
		"smoke": "node --import tsx scripts/smoke.ts",
		"prepare": "lefthook install",
		"prepublishOnly": "bun run check && bun run plugin:build"
	},
	"devDependencies": {
		"@medusajs/admin-sdk": "2.21.2",
		"@medusajs/cli": "2.21.2",
		"@medusajs/framework": "2.21.2",
		"@medusajs/medusa": "2.21.2",
		"@medusajs/test-utils": "2.21.2",
		"@swc/core": "^1.16.18",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.11.0",
		"jest": "^29.7.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.88.0",
		"ts-jest": "^29.4.15",
		"tsx": "^4.23.15",
		"typescript": "^5.4.5"
	},
	"peerDependencies": {
		"@medusajs/framework": "2.x"
	},
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=24"
	},
	"trustedDependencies": [
		"@medusajs/telemetry",
		"@swc/core",
		"protobufjs"
	]
}
